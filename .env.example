# Copy this file to .env and fill in your own Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: Stripe publishable key for local checkout testing, used in
# .env.development. Safe to be public (it's a publishable, not secret, key).
VITE_PAYMENTS_CLIENT_TOKEN=
