      {
        "name": "add_observation",
        "title": "Add observation",
        "description": "Add an observation row to a session. Identify the star either by id or by catalog name; comparison values A/B accept magnitudes or comparator letters.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "session_id": {
              "type": "string",
              "format": "uuid",
              "description": "Session the observation belongs to."
            },
            "star_id": {
              "type": "string",
              "format": "uuid",
              "description": "Catalog star id."
            },
            "star_name": {
              "type": "string",
              "minLength": 1,
              "description": "Catalog star name (used when star_id is omitted)."
            },
            "a": {
              "type": "string",
              "description": "Brighter comparison star (magnitude or comparator letter)."
            },
            "b": {
              "type": "string",
              "description": "Fainter comparison star (magnitude or comparator letter)."
            },
            "pasos_a": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99,
              "description": "Argelander steps to A."
            },
            "pasos_b": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99,
              "description": "Argelander steps to B."
            },
            "limit_value": {
              "type": "string",
              "description": "Fainter-than limit, e.g. '<14.2'."
            },
            "ut_time": {
              "type": "string",
              "description": "UT time as HH:MM."
            },
            "note": {
              "type": "string",
              "maxLength": 500,
              "description": "Row note, e.g. OUTBURST."
            }
          },
          "required": [
            "session_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
